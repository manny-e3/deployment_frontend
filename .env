# ==============================================================================
# LOCAL DEVELOPMENT (npm run dev)
# ==============================================================================
# Leave VITE_API_URL empty so requests route through the Vite dev proxy (/api).
# The Vite proxy forwards to VITE_PROXY_TARGET (your local Docker backend on port 9000).
VITE_API_URL=
VITE_PROXY_TARGET=http://localhost:9000

# ==============================================================================
# DOCKER PRODUCTION SETTINGS (When running inside Docker)
# ==============================================================================
PORT=3000
BACKEND_URL=http://api:9000
DOCKER_NETWORK=deploy-portal_default
